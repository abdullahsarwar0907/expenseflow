<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ExpenseFlow - Track Your Money, Simply</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="landing">
    <header class="landing-hero">
        <h1>ExpenseFlow</h1>
        <p>Track your income, expenses, and budgets — all in one place.</p>
        <div class="landing-actions">
            <a href="/register" class="btn btn-primary">Get Started</a>
            <a href="/login" class="btn btn-secondary">Login</a>
        </div>
    </header>

    <section class="landing-features">
        <div class="feature">
            <h3>📊 Dashboard</h3>
            <p>See your balance, income, and expenses at a glance with visual charts.</p>
        </div>
        <div class="feature">
            <h3>💰 Budgets</h3>
            <p>Set monthly limits per category and get warned before you overspend.</p>
        </div>
        <div class="feature">
            <h3>🔁 Recurring</h3>
            <p>Automate rent, salary, and subscriptions so you never forget to log them.</p>
        </div>
        <div class="feature">
            <h3>📄 Export</h3>
            <p>Download your transaction history as CSV or PDF anytime.</p>
        </div>
    </section>

    <script src="/js/theme.js"></script>
</body>

</html>