<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - ExpenseFlow</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <h1>Your Profile</h1>
    <%- include('../partials/navbar') %>

        <h3>Update Details</h3>
        <form action="/profile" method="POST">
            <input type="text" name="name" value="<%= user.name %>" required>
            <input type="email" value="<%= user.email %>" disabled>
            <select name="currency">
                <option value="INR" <%=user.currency==='INR' ? 'selected' : '' %>>INR (₹)</option>
                <option value="USD" <%=user.currency==='USD' ? 'selected' : '' %>>USD ($)</option>
                <option value="EUR" <%=user.currency==='EUR' ? 'selected' : '' %>>EUR (€)</option>
            </select>
            <button type="submit">Save Details</button>
        </form>

        <h3>Change Password</h3>
        <form action="/profile/password" method="POST">
            <input type="password" name="currentPassword" placeholder="Current Password" required>
            <input type="password" name="newPassword" placeholder="New Password" required minlength="6">
            <button type="submit">Update Password</button>
        </form>

        <script src="/js/theme.js"></script>
</body>

</html>