<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Transaction - ExpenseFlow</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <h1>Edit Transaction</h1>
    <%- include('../partials/navbar') %>

        <form action="/transactions/<%= transaction._id %>/edit" method="POST">
            <input type="number" name="amount" value="<%= transaction.amount %>" step="0.01" min="0" required>

            <select name="type" required>
                <option value="income" <%=transaction.type==='income' ? 'selected' : '' %>>Income</option>
                <option value="expense" <%=transaction.type==='expense' ? 'selected' : '' %>>Expense</option>
            </select>

            <select name="category" required>
                <% categories.forEach(function(cat) { %>
                    <option value="<%= cat._id %>" <%=String(cat._id)===String(transaction.category) ? 'selected' : ''
                        %>>
                        <%= cat.icon %>
                            <%= cat.name %>
                    </option>
                    <% }); %>
            </select>

            <select name="paymentMethod">
                <option value="cash" <%=transaction.paymentMethod==='cash' ? 'selected' : '' %>>Cash</option>
                <option value="upi" <%=transaction.paymentMethod==='upi' ? 'selected' : '' %>>UPI</option>
                <option value="card" <%=transaction.paymentMethod==='card' ? 'selected' : '' %>>Card</option>
                <option value="netbanking" <%=transaction.paymentMethod==='netbanking' ? 'selected' : '' %>>Net Banking
                </option>
                <option value="other" <%=transaction.paymentMethod==='other' ? 'selected' : '' %>>Other</option>
            </select>

            <input type="text" name="note" value="<%= transaction.note %>" placeholder="Note (optional)">

            <input type="date" name="date" value="<%= transaction.date.toISOString().split('T')[0] %>" required>

            <button type="submit">Update Transaction</button>
        </form>

        <form action="/transactions/<%= transaction._id %>/delete" method="POST"
            onsubmit="return confirm('Delete this transaction?');">
            <button type="submit">Delete Transaction</button>
        </form>

    <script src="/js/theme.js"></script>
</body>

</html>